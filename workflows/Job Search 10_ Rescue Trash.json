              "key": "Rescued|checkbox",
              "condition": "equals"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.notion",
      "typeVersion": 3,
      "position": [
        224,
        0
      ],
      "id": "c230df9b-aec4-4ab9-947b-c6bfc89b8db5",
      "name": "Get Rescue Rows"
    },
    {
      "parameters": {
        "jsCode": "const val = (j, name) => {\n  const key = 'property_' + name.toLowerCase().replace(/[^a-z0-9]+/g, '_');\n  if (j[key] !== undefined && j[key] !== null) return j[key];\n  const p = j.properties && j.properties[name];\n  if (!p) return '';\n  if (p.title) return p.title.map(t => t.plain_text).join('');\n  if (p.rich_text) return p.rich_text.map(t => t.plain_text).join('');\n  if (p.number !== undefined) return p.number;\n  if (p.url !== undefined) return p.url || '';\n  if (p.select) return p.select.name;\n  return '';\n};\n\nconst out = [];\nfor (const i of $input.all()) {\n  const j = i.json;\n  const description = String(val(j, 'Description') || '').trim();\n\n  // No real description yet (empty, too short, or the LinkedIn placeholder): leave it in Trash\n  if (description.length < 200 || /Imported from a LinkedIn/i.test(description)) continue;\n\n  const original = val(j, 'Source') || 'Unknown';\n  const empRaw = val(j, 'Employees');\n  const employees = (empRaw === '' || empRaw === null || isNaN(Number(empRaw))) ? null : Number(empRaw);\n\n  out.push({ json: {\n    trash_id: j.id,\n    name: val(j, 'Name') || j.name || '',\n    company: val(j, 'Company'),\n    location: val(j, 'Location'),\n    work_type: val(j, 'Work Type'),\n    employees: employees,\n    job_url: val(j, 'URL'),\n    source: 'Rescued from Trash (' + original + ')',\n    pre_score: 100,\n    decision: 'Will Apply',\n    description: description.slice(0, 1990)\n  } });\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "cdeee147-f3e2-48f4-9d0c-dde3b613cd7f",
      "name": "Build Jobs Rows"
    },
