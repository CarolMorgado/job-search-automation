      "id": "d3abfaee-194d-417c-810f-dfa171d68ad6",
      "name": "Get Contacts",
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const MAX_PER_JOB = 10; // maximum contacts linked to one job\n\nconst jobs = $('Get Jobs').all().map(i => i.json).filter(j => j.id);\nconst contacts = $('Get Contacts').all().map(i => i.json).filter(c => c.id);\n\n// Contacts with these roles are listed first, because they can help most\nconst PRIORITY = /recruit|talent|hiring|hr |human resources|people|project|programme|program|pmo|business analyst|product|head|director|manager/i;\n\n// Map: company page id -> contacts who work there\nconst byCompany = {};\nfor (const c of contacts) {\n  const cos = Array.isArray(c.property_companies) ? c.property_companies : [];\n  for (const id of cos) {\n    (byCompany[id] = byCompany[id] || []).push(c);\n  }\n}\n\nconst out = [];\nfor (const j of jobs) {\n  const cos = Array.isArray(j.property_company) ? j.property_company : [];\n  let matches = [];\n  for (const id of cos) matches = matches.concat(byCompany[id] || []);\n  if (!matches.length) continue;\n\n  matches.sort((a, b) => {\n    const pa = PRIORITY.test(a.property_position || '') ? 0 : 1;\n    const pb = PRIORITY.test(b.property_position || '') ? 0 : 1;\n    return pa - pb;\n  });\n\n  const ids = [...new Set(matches.map(m => m.id))].slice(0, MAX_PER_JOB);\n\n  // Skip jobs that already have exactly these contacts\n  const current = Array.isArray(j.property_contacts) ? j.property_contacts : [];\n  if (current.length === ids.length && ids.every(x => current.includes(x))) continue;\n\n  out.push({ json: { job_id: j.id, contact_ids: ids, contact_count: matches.length } });\n}\n\n// Debug: only appears when there is nothing to link\nif (!out.length) {\n  return [{ json: {\n    debug: true,\n    note: 'No job needs linking. Do not run Link Contacts to Job with this item.',\n    jobs: jobs.length,\n    contacts: contacts.length,\n    contacts_with_company: contacts.filter(c => Array.isArray(c.property_companies) && c.property_companies.length).length,\n    jobs_with_company: jobs.filter(j => Array.isArray(j.property_company) && j.property_company.length).length,\n    contact_fields: Object.keys(contacts[0] || {}),\n    job_fields: Object.keys(jobs[0] || {})\n  } }];\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "3a47ddae-38ee-4bfb-b1ec-b9633c970187",
